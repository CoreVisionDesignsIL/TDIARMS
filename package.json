{
  "name": "tdi-arms-website",
  "version": "1.0.0",
  "description": "TDI Arms - Ultimate Weapon Accessories E-commerce Website",
  "main": "index.php",
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "production": "mix --production",
    "build": "npm run production",
    "lint:css": "stylelint **/*.scss",
    "lint:js": "eslint resources/js/**/*.js",
    "test": "npm run lint:css && npm run lint:js",
    "deploy": "npm run production && rsync -avz --delete ./ user@server:/var/www/tdiarms.com/"
  },
  "keywords": [
    "tdi-arms",
    "tactical",
    "weapons",
    "accessories",
    "e-commerce",
    "wordpress",
    "woocommerce"
  ],
  "author": "TDI Arms Development Team",
  "license": "proprietary",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.48.0",
    "laravel-mix": "^6.0.49",
    "postcss": "^8.4.29",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.10.2",
    "stylelint-config-standard-scss": "^10.0.0",
    "tailwindcss": "^3.3.3",
    "vue-template-compiler": "^2.7.14"
  },
  "dependencies": {
    "alpinejs": "^3.13.0",
    "gsap": "^3.12.2",
    "swiper": "^10.3.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}